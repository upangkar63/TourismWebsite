<% layout("/layouts/boilerplate")  %>
<style>
     .index {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 20px;
            font-weight: bold;
            letter-spacing: 1px;
            line-height: 1.2;
            text-shadow: 4px 4px 10px rgba(0, 0, 0, 0.2);
        }
        .carousel-control-prev,
        .carousel-control-next {
            display: none;
        }

        .card:hover .carousel-control-prev,
        .card:hover .carousel-control-next {
            display: flex;
        }
</style>
<h3 class="index mb-4">ALL PACKAGES</h3>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let package of domPackages) { %>
        <div class="card col">
            <!-- <img src="" class="card-img-top" alt="tour_image" style="height: 18rem;"> -->

            <div id="packageCarousel<%=package._id%>" class="carousel slide">
                <div class="carousel-inner">
                    <% package.image.forEach(function(image, index) { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                            <img src="<%= image %>" class="d-block w-100 show-img" alt="pack_image" id="image"
                                style="height: 18rem;">
                        </div>
                        <% }) %>
                </div>
                <a class="carousel-control-prev" href="#packageCarousel<%=package._id%>" role="button"
                    data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </a>
                <a class="carousel-control-next" href="#packageCarousel<%=package._id%>" role="button"
                    data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </a>
            </div>
            <div class="card-img"></div>
            <div class="card-body">
                <h5 class="card-title"><b>
                        <%= package.title %>
                    </b></h5>
                <p><b>&#8377; <%=package.price.toLocaleString("en-IN")%> </b></p>
                <a href="/packages/domestic/<%= package._id %>" class="btn btn-dark">See Details</a>
            </div>
        </div>

        <% } %>

        <% for(let package of intPackages) { %>
          <div class="card col">
              <!-- <img src="" class="card-img-top" alt="tour_image" style="height: 18rem;"> -->
  
              <div id="packageCarousel<%=package._id%>" class="carousel slide">
                  <div class="carousel-inner">
                      <% package.image.forEach(function(image, index) { %>
                          <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                              <img src="<%= image %>" class="d-block w-100 show-img" alt="pack_image" id="image"
                                  style="height: 18rem;">
                          </div>
                          <% }) %>
                  </div>
                  <a class="carousel-control-prev" href="#packageCarousel<%=package._id%>" role="button"
                      data-bs-slide="prev">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Previous</span>
                  </a>
                  <a class="carousel-control-next" href="#packageCarousel<%=package._id%>" role="button"
                      data-bs-slide="next">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Next</span>
                  </a>
              </div>
              <div class="card-img"></div>
              <div class="card-body">
                  <h5 class="card-title"><b>
                          <%= package.title %>
                      </b></h5>
                  <p><b>&#8377; <%=package.price.toLocaleString("en-IN")%> </b></p>
                  <a href="/packages/domestic/<%= package._id %>" class="btn btn-dark">See Details</a>
              </div>
          </div>
  
          <% } %>
</div>
</div>