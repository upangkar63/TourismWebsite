<% layout("/layouts/boilerplate") %>
    <style>
        gear-img {
            object-fit: cover;
        }

        .carousel-control-prev,
        .carousel-control-next {
            display: none;
        }

        .card:hover .carousel-control-prev,
        .card:hover .carousel-control-next {
            display: flex;
        }


        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            background-color: rgba(0, 0, 0, 0.5);
            border-radius: 50%;
            padding: 10px;
        }

        .carousel-control-prev-icon:hover,
        .carousel-control-next-icon:hover {
            border: 1px solid rgb(245, 217, 217);
            background-color: rgba(100, 98, 98, 0.5);
            border-radius: 50%;
            padding: 10px;
        }

        .cart {
            border: 2px solid black !important;
            margin-right: 2px;
        }
    </style>
    <div class="card-content mt-4">
        <% for (let gear of gears) { %>
            <div class="card col">

                <div id="gearCarousel<%=gear._id%>" class="carousel slide">
                    <div class="carousel-inner">
                        <% gear.image.forEach(function(image, index) { %>
                            <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                <img src="<%= image %>" class="d-block w-100 gear-img" alt="gear_image" id="image"
                                    style="height: 25rem;">
                            </div>
                            <% }) %>
                    </div>
                    <a class="carousel-control-prev" href="#gearCarousel<%=gear._id%>" role="button"
                        data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#gearCarousel<%=gear._id%>" role="button"
                        data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </a>
                </div>
                
                <div class="card-body">
                    <h5 class="card-title">
                        <%= gear.name %>
                    </h5>
                    <p><b>&#8377; <%=gear.price.toLocaleString("en-IN")%> </b></p>

                    <a href="/travel-gears/<%= gear._id %>" class="btn btn-dark ">Buy</a>
                    <a href="/travel-gears/<%= gear._id %>" class="btn btn-outline-dark cart">Add to cart</a>

                </div>
            </div>

            <% } %>
    </div>