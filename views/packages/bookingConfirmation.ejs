<% layout("/layouts/boilerplate") %>
<style>
.booking-details {
    max-width: 800px;
    margin: 20px auto;
    padding: 20px;
    border: 1px solid #ddd;
    background-color: #fafafa;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.booking-details h2 {
    text-align: center;
    color: #333;
    margin-bottom: 20px;
}
.pack_image {
    height: 15rem;
    width: auto;
    border-radius: 8px;
}
.booking-details p {
    font-size: 16px;
    line-height: 1.6;
    color: #555;
    margin: 10px 0;
}

.booking-details strong {
    font-weight: bold;
    color: #333;
}

.booking-details p:last-child {
    margin-bottom: 0;
}

.booking-details .info-group {
    margin-bottom: 15px;
}

.booking-details .info-group p {
    margin: 5px 0;
}

.booking-details .info-group p strong {
    color: #007BFF; 
}

</style>

<h2 class="offset-3 mt-5">Booking Confirmation</h2>

<div class="booking-details">
    <p><img src="<%= booking.packageId.image[0] %>" alt="pack_image" class="pack_image"></p>
    <p><strong>Package:</strong> <%= booking.packageId.title %></p>
    <p><strong>Traveler:</strong> <%= booking.name %></p>
    <p><strong>Email:</strong> <%= booking.email %></p>
    <p><strong>Phone:</strong> <%= booking.phoneno %></p>
    <p><strong>State:</strong> <%= booking.state %></p>
    <p><strong>City:</strong> <%= booking.city %></p>
    <p><strong>Travel Date:</strong> <%= booking.travelDate.toLocaleDateString() %></p>
    <p><strong>Number of People:</strong> <%= booking.packSize %></p>
    <p><strong>Price:</strong> <%= booking.totalPrice %></p>
</div>

<a href="/packages/domestic" class="btn btn-dark mb-5 offset-3" style="display: inline-block;">Back to Packages</a>

