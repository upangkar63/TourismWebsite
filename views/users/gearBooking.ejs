<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Your Orders</h2>

    <table class="table table-bordered table-striped table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Title</th>
                <th>Price</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            <% if (bookings.length === 0) { %>
                <tr>
                    <td colspan="12" class="text-center text-danger">No bookings found.</td>
                </tr>
            <% } else { %>
                <% bookings.forEach(booking => { %>
                    <tr>
                        <td>
                            <% if (booking.gearId) { %>
                              
                                <img src="<%= booking.gearId.image[0] %>" alt="package_image" class="package-image img-fluid" />
                            <% } else { %>
                                <img src="default-image-url.jpg" alt="No image available" class="package-image img-fluid" />
                            <% } %>
                        </td>
                        <td><%= booking.name %></td>
                        <td><%= booking.email %></td>
                        <td><%= booking.phoneno %></td>
                      
                        <td>
                            <% if (booking.gearId) { %>
                                <a href="/travel-gears/<%= booking.gearId._id%>" class="text-primary"><%= booking.gearId.name %></a>
                            <% } else { %>
                                N/A
                            <% } %>
                        </td>
                        <td>
                            <% if (booking.gearId) { %>
                                &#8377; <%= booking.gearId.price.toLocaleString("en-IN") %>
                            <% } else { %>
                                N/A
                            <% } %>
                        </td>
        
                        <td>
                            <a href="/my-bookings/gears/details/<%= booking._id %>" class="btn btn-info btn-sm">See details</a>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Add custom styling -->
<style>
    /* Table styling */
    .table {
        border-collapse: collapse;
        width: 100%;
        margin-top: 20px;
    }

    .table th, .table td {
        text-align: center;
        padding: 10px;
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }

    .thead-dark {
        background-color: #343a40;
        color: white;
    }

    /* Responsive Image Styling */
    .package-image {
        border-radius: 10px; 
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); 
        transition: transform 0.3s ease, box-shadow 0.3s ease; 
        max-width: 100%; 
        height: 10rem !important;
    }

    .package-image:hover {
        transform: scale(1.05); 
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2); 
    }

    /* Button Styling */
    .btn-info {
        background-color: #1b7bdb;
        color: white;
        border-radius: 5px;
        font-size: 14px;
        padding: 8px 16px;
        transition: background-color 0.3s ease;
    }

    .btn-info:hover {
        background-color: #1d66a1;
        color: white;
    }

    .btn-sm {
        font-size: 14px;
        padding: 5px 10px;
    }

    /* Table Responsiveness */
    @media (max-width: 768px) {
        .table th, .table td {
            font-size: 12px;
            padding: 8px;
        }

        .container {
            padding: 10px;
        }

        .package-image {
            height: 6rem;
            width: 100%;
        }
    }

    .text-danger {
        color: #dc3545;
        font-weight: bold;
    }
</style>
